# Template for .env or the hosting platform's environment settings. Every value here is optional.

PORT=3000
DATABASE_PATH=./data/hms.sqlite
HOTEL_CONFIG_PATH=./config/hotel.json
# Wipe and re-seed the database on every start (handy for a public demo).
RESET_DB_ON_START=false

# ---- Auto-progress of service requests (simulated hotel staff) ----
AUTO_ADVANCE_ENABLED=true
# How often the scheduler looks for due requests.
AUTO_ADVANCE_TICK_SECONDS=2
# Default time each status lasts before moving to the next one.
AUTO_ADVANCE_SECONDS=10
# Per-service overrides: uncomment to give a service its own speed (unset = the default above).
# AUTO_ADVANCE_SECONDS_FOOD=10
# AUTO_ADVANCE_SECONDS_LAUNDRY=10
# AUTO_ADVANCE_SECONDS_HOUSEKEEPING=10
# AUTO_ADVANCE_SECONDS_AMENITY=10
# AUTO_ADVANCE_SECONDS_MAINTENANCE=10
# AUTO_ADVANCE_SECONDS_SPA=10
# AUTO_ADVANCE_SECONDS_TRANSFER=10
# A room left dirty at check-out is clean again after this long.
HOUSEKEEPING_TURNAROUND_SECONDS=300

# Allow online check-in this many days before arrival (0 = arrival day only).
EARLY_CHECKIN_DAYS=0
# Failed booking/Stay ID lookups allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=30
