{
  "name": "white-label-hms",
  "version": "0.1.0",
  "description": "White-label hotel guest platform: booking, online check-in, in-stay services, live folio and express check-out.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:reset": "RESET_DB_ON_START=true node --disable-warning=ExperimentalWarning --import tsx src/server/db/reset.ts",
    "e2e": "node tests/e2e/journey.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
